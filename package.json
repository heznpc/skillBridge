{
  "name": "skillbridge",
  "version": "4.2.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "jest --verbose",
    "test:ci": "jest --runInBand --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:first-user": "npm run build:bundle && playwright test tests/e2e/first-user-flow.spec.js tests/e2e/popup.spec.js",
    "e2e:install": "playwright install chromium",
    "glossary": "node scripts/check-glossary.js",
    "validate": "node scripts/validate-translations.js",
    "build:zip": "npm run build:bundle:zip",
    "build:developer:zip": "rm -f store-assets/skillbridge-developer.zip && zip -r store-assets/skillbridge-developer.zip manifest.json _locales/ src/ assets/icons/ LICENSE THIRD_PARTY_NOTICES.md licenses/ -x '*.DS_Store'",
    "build:firefox": "node scripts/build-firefox.js",
    "build:firefox:zip": "npm run build:firefox && cd dist/firefox && rm -f ../../store-assets/skillbridge-firefox.zip && zip -r ../../store-assets/skillbridge-firefox.zip . -x '*.DS_Store'",
    "check:selectors": "node scripts/check-selectors.js",
    "check:version": "node scripts/check-version-sync.js",
    "check:models": "node scripts/check-tutor-models.js",
    "check:dicts": "node scripts/check-dicts.js",
    "check:sync": "node scripts/check-bg-sync.js",
    "check:i18n": "node scripts/check-i18n-keys.js",
    "check:locales": "node scripts/check-locale-contamination.js",
    "check:dict-coverage": "node scripts/check-dict-coverage.js",
    "check:academy": "node scripts/check-academy-courses.js",
    "check:canonical": "node scripts/build-canonical-lookup.js --check",
    "build:canonical": "node scripts/build-canonical-lookup.js",
    "check:permission-docs": "node scripts/check-permission-docs.js",
    "check:plugin": "node scripts/build-plugin.js --check",
    "check:cws-drift": "node scripts/check-cws-drift.js",
    "cws:auth": "node scripts/cws-auth.js",
    "cws:auth:verify": "node scripts/cws-auth.js --verify-only",
    "deploy:cws:draft": "gh workflow run cd.yml -f publish=false -f force=true",
    "build:plugin": "node scripts/build-plugin.js",
    "docs": "npm run docs:metadata && npm run landing:build",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{js,css,html}' 'tests/**/*.js' 'scripts/**/*.js'",
    "format:check": "prettier --check 'src/**/*.{js,css,html}' 'tests/**/*.js' 'scripts/**/*.js'",
    "build:bundle": "node scripts/build-bundle.js",
    "build:bundle:zip": "rm -f store-assets/skillbridge.zip && npm run build:bundle && cd dist/bundled && rm -f ../../store-assets/skillbridge-bundled.zip && zip -r ../../store-assets/skillbridge-bundled.zip . -x '*.DS_Store'",
    "release:smoke": "node scripts/release-pipeline.js --smoke",
    "release:preflight": "node scripts/release-pipeline.js --preflight",
    "release:postupload": "node scripts/release-pipeline.js --post-upload",
    "release:verify": "node scripts/release-pipeline.js --full",
    "capture:store": "shotkit",
    "promo:build": "npm run capture:store && node scripts/build-promo-media.js",
    "capture:install": "playwright install chromium",
    "check:window": "node scripts/check-window-surface.js",
    "landing:dev": "astro dev --root site",
    "landing:build": "astro build --root site && node scripts/publish-landing.cjs",
    "landing:verify": "astro build --root site",
    "docs:metadata": "node scripts/generate-docs.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "<rootDir>/.claude/worktrees/",
      "/tests/e2e/"
    ],
    "modulePathIgnorePatterns": [
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "scripts/**/*.js",
      "!src/bridge/puter.js"
    ],
    "coverageThreshold": {
      "./scripts/lib/**/*.js": {
        "statements": 90,
        "branches": 75,
        "functions": 90,
        "lines": 90
      },
      "./scripts/check-rhc.js": {
        "statements": 85,
        "branches": 65,
        "functions": 95,
        "lines": 85
      },
      "./src/lib/dom-safe.js": {
        "statements": 90,
        "branches": 75,
        "functions": 90,
        "lines": 90
      },
      "./src/content/html-gt.js": {
        "statements": 85,
        "branches": 65,
        "functions": 90,
        "lines": 90
      },
      "./src/background/background.js": {
        "statements": 50,
        "branches": 45,
        "functions": 60,
        "lines": 50
      },
      "./src/content/chat-flashcards.js": {
        "statements": 80,
        "branches": 70,
        "functions": 75,
        "lines": 80
      },
      "./src/content/content-lifecycle.js": {
        "statements": 80,
        "branches": 55,
        "functions": 70,
        "lines": 80
      },
      "./src/content/content-messages.js": {
        "statements": 85,
        "branches": 75,
        "functions": 85,
        "lines": 85
      },
      "./src/content/gt-queue.js": {
        "statements": 70,
        "branches": 60,
        "functions": 85,
        "lines": 80
      },
      "./src/popup/popup.js": {
        "statements": 60,
        "branches": 40,
        "functions": 40,
        "lines": 65
      },
      "./src/lib/translation-feedback.js": {
        "statements": 85,
        "branches": 80,
        "functions": 95,
        "lines": 90
      },
      "./src/lib/tutor-conversations.js": {
        "statements": 80,
        "branches": 65,
        "functions": 90,
        "lines": 85
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@starter-series/shotkit": "^1.1.1",
    "astro": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
