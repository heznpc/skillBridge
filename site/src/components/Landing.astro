---
import type { Copy, Locale } from '../i18n';
import { localePath } from '../i18n';
import { buildInfo } from '../data/build-info';

interface Props { copy: Copy; locale: Locale; }
const { copy, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const storeUrl = 'https://chromewebstore.google.com/detail/skillbridge-for-anthropic/oancfldkbnajdadgekkjpdnhepjjcdln';
const privacyUrl = `${base}privacy.html`;

const ui = locale === 'ko'
  ? {
      navFlow: '사용 흐름', navContext: '문맥 안에서', install: 'CWS — 기존 v1.0.1',
      eyebrow: '지원 강의 안에서 시작됩니다', title: '강의를 떠나지 않고, 언어만 바꾸세요.',
      lead: 'SkillBridge는 지원되는 AI Academy 수업의 탐색·본문·학습 도구가 있는 원래 화면 안에서 필요한 언어를 더합니다.',
      versionNotice: `이 페이지는 아직 배포되지 않은 소스 후보 v${buildInfo.version}을 설명합니다. Chrome 웹 스토어에서는 기존 v1.0.1이 설치되며, 새 버전 공개는 검증이 끝날 때까지 중단된 상태입니다.`,
      launch: '사용 흐름 보기', flowTitle: '강의를 읽는 방식은 그대로입니다.',
      flowLead: '바뀌는 것은 언어뿐입니다. 탐색, 핵심 용어, 멈춘 지점, 복습 도구는 수업 맥락 안에 남습니다.',
      stepOpen: '지원 강의를 엽니다', stepOpenBody: '평소처럼 AI Academy 수업을 엽니다. 별도의 작업 공간이나 복사·붙여넣기 화면은 필요하지 않습니다.',
      stepChoose: '지구본 메뉴에서 언어를 고릅니다', stepChooseBody: '선택하는 즉시 현재 수업의 읽을 수 있는 텍스트가 같은 위치에서 바뀝니다.',
      stepStay: '이해가 필요한 순간에도 수업 안에 머뭅니다', stepStayBody: 'Tutor, 플래시카드, 북마크는 옆으로 열립니다. 읽던 문단을 잃지 않습니다.',
      demoLabel: '라이브 전환 데모', demoHint: '언어를 선택해 보세요', course: 'AI Academy · Tool use', lesson: 'Lesson 02', local: '브라우저 내 전환',
      original: '원문', translated: '선택 언어', contextEyebrow: '문맥은 그대로', contextTitle: '번역은 다른 탭으로 가지 않습니다.',
      contextBody: '강의 목록과 본문, 복습 도구가 같은 흐름 안에 남아 있어 읽기를 멈추고 다시 찾을 필요가 없습니다.',
      contextNote: 'Tutor와 복습 도구는 현재 문단 옆에서 열립니다.',
      finalTitle: '강의가 이해되는 언어로, 바로 읽기 시작하세요.', finalBody: '계정 없이 번역을 켜고, 필요한 순간에만 학습 도구를 사용하세요.',
      source: 'GitHub에서 소스 보기', footer: '독립 커뮤니티 프로젝트. Anthropic 또는 Skilljar와 제휴·후원·승인 관계가 아닙니다.',
      privacy: '개인정보 처리방침', sourceLabel: 'GitHub', license: 'MIT 라이선스',
      translatedAt: '현재 언어로 전환됨', keepTerms: '전문 용어 유지', flowTag: '강의 흐름 유지', languages: '개 언어',
      lessonAlt: 'SkillBridge 번역이 켜진 AI Academy 강의', contextAlt: 'SkillBridge 조작 화면이 보이는 번역된 AI Academy 강의',
    }
  : {
      navFlow: 'The flow', navContext: 'In context', install: 'CWS — legacy v1.0.1',
      eyebrow: 'It starts inside a supported course', title: 'Change the language, not the way you learn.',
      lead: 'SkillBridge adds the language you need to the original AI Academy screen, where navigation, lesson text, and study tools already live.',
      versionNotice: `This page describes the unpublished v${buildInfo.version} source candidate. The Chrome Web Store still installs legacy v1.0.1; publication remains paused while the replacement is verified.`,
      launch: 'See the flow', flowTitle: 'The lesson stays where it is.',
      flowLead: 'Only the language changes. Navigation, protected terminology, your place in the course, and review tools remain in the lesson context.',
      stepOpen: 'Open a supported lesson', stepOpenBody: 'Start in AI Academy as usual. There is no second workspace and no copy-paste translation loop.',
      stepChoose: 'Choose a language from the globe menu', stepChooseBody: 'The readable text on the current lesson changes in place as soon as you choose a language.',
      stepStay: 'Stay in the lesson when you need help', stepStayBody: 'Tutor, flashcards, and bookmarks open beside the course. The paragraph you were reading remains visible.',
      demoLabel: 'Live switch demo', demoHint: 'Choose a language', course: 'AI Academy · Tool use', lesson: 'Lesson 02', local: 'In-browser switch',
      original: 'Original', translated: 'Selected language', contextEyebrow: 'Context remains', contextTitle: 'Translation does not send you to another tab.',
      contextBody: 'The course list, lesson body, and review tools stay in one path, so you do not have to stop reading to find your way back.',
      contextNote: 'Tutor and review tools open beside the paragraph you are reading.',
      finalTitle: 'Open the lesson. Read it in the language that works for you.', finalBody: 'Turn translation on without an account, then use study tools only when you need them.',
      source: 'View source on GitHub', footer: 'Independent community project. Not affiliated with, sponsored by, or endorsed by Anthropic or Skilljar.',
      privacy: 'Privacy', sourceLabel: 'GitHub', license: 'MIT license',
      translatedAt: 'Switched for this lesson', keepTerms: 'Terms preserved', flowTag: 'Lesson flow retained', languages: 'languages',
      lessonAlt: 'AI Academy lesson with SkillBridge translation enabled', contextAlt: 'A translated AI Academy lesson with SkillBridge controls',
    };

const initialLanguage = locale === 'ko' ? 'ko' : 'en';
const demoText = locale === 'ko'
  ? {
      language: '\uBC88\uC5ED \uC5B8\uC5B4', auto: '\uC774 \uAC15\uC758 \uC790\uB3D9 \uBC88\uC5ED', comments: '\uB313\uAE00\uB3C4 \uBC88\uC5ED', openSidebar: '\uC0AC\uC774\uB4DC\uBC14 \uC5F4\uAE30', learningTools: '\uD559\uC2B5 \uB3C4\uAD6C', askPassage: '\uD604\uC7AC \uBB38\uB2E8\uC5D0 \uC9C8\uBB38\uD558\uAE30', recentLessons: '\uCD5C\uADFC \uAC15\uC758', bookmarks: '\uBD81\uB9C8\uD06C', notes: '\uB178\uD2B8', reports: '\uC6A9\uC5B4 \uB9AC\uD3EC\uD2B8', flashcards: '\uD50C\uB798\uC2DC\uCE74\uB4DC', exportPdf: 'PDF \uB0B4\uBCF4\uB0B4\uAE30', closeSidebar: '\uC0AC\uC774\uB4DC\uBC14 \uB2EB\uAE30', tutorGreeting: '\uAC15\uC758 \uB0B4\uC6A9\uC744 \uB5A0\uB098\uC9C0 \uC54A\uACE0 \uC9C8\uBB38\uD574 \uBCF4\uC138\uC694.', send: '\uBCF4\uB0B4\uAE30', currentLesson: '\uD604\uC7AC \uAC15\uC758\uC5D0 \uBC88\uC5ED\uC774 \uCF1C\uC838 \uC788\uC2B5\uB2C8\uB2E4.'
    }
  : {
      language: 'Translate to', auto: 'Auto-translate this lesson', comments: 'Translate comments', openSidebar: 'Open SkillBridge sidebar', learningTools: 'Learning tools', askPassage: 'Ask about this passage', recentLessons: 'Recent lessons', bookmarks: 'Bookmarks', notes: 'Notes', reports: 'Term reports', flashcards: 'Flashcards', exportPdf: 'Export PDF', closeSidebar: 'Close sidebar', tutorGreeting: 'Ask about the lesson without leaving the page.', send: 'Send', currentLesson: 'Translation is enabled for this lesson.'
    };
---
<header class="flow-header shell">
  <a class="mark" href={localePath('en', base)} aria-label="SkillBridge home">
    <img src={`${base}images/icon128.png`} alt="" width="34" height="34" />
    <span>SkillBridge</span>
  </a>
  <nav class="flow-nav" aria-label="Primary navigation">
    <a href="#flow">{ui.navFlow}</a>
    <a href="#context">{ui.navContext}</a>
  </nav>
  <div class="header-right">
    <nav class="locale-toggle" aria-label="Language">
      <a class:list={[{ current: locale === 'en' }]} href={localePath('en', base)} hreflang="en">EN</a>
      <a class:list={[{ current: locale === 'ko' }]} href={localePath('ko', base)} hreflang="ko">한국어</a>
    </nav>
    <a class="header-install" href={storeUrl}>{ui.install}</a>
  </div>
</header>

<main>
  <section class="opening shell" aria-labelledby="opening-title">
    <div class="opening-index"><span>01</span><i></i><small>{ui.eyebrow}</small></div>
    <div class="opening-copy">
      <h1 id="opening-title">{ui.title}</h1>
      <p>{ui.lead}</p>
      <p class="version-notice"><strong>{locale === 'ko' ? '버전 안내' : 'Version notice'}</strong> {ui.versionNotice}</p>
      <a class="anchor-link" href="#flow"><span>↓</span>{ui.launch}</a>
    </div>
    <div class="opening-meta"><span>{buildInfo.languageCount}{locale === 'ko' ? '' : ' '}{ui.languages}</span><span>{ui.local}</span></div>
  </section>

  <section class="journey" id="flow" aria-labelledby="journey-title">
    <div class="journey-header shell"><div><p class="section-kicker">02 / {ui.demoLabel}</p><h2 id="journey-title">{ui.flowTitle}</h2></div><p>{ui.flowLead}</p></div>

  <div class="journey-stage shell">
    <aside class="journey-rail" aria-label="Product flow">
      <button class="rail-item active" type="button" data-flow-step="popup" aria-current="step"><span>01</span><p>{ui.stepOpen}</p></button>
      <button class="rail-item" type="button" data-flow-step="language"><span>02</span><p>{ui.stepChoose}</p></button>
      <button class="rail-item" type="button" data-flow-step="sidebar"><span>03</span><p>{ui.stepStay}</p></button>
    </aside>
    <div class="extension-demo" data-extension-demo data-locale={locale}>
      <figure class="extension-capture">
        <img src={`${base}images/lesson-translated.png`} alt={ui.lessonAlt} />
        <figcaption><span class="capture-dot"></span>{ui.local}</figcaption>
      </figure>
      <aside class="extension-popup" aria-label="SkillBridge extension settings">
        <div class="extension-popup-head"><img src={`${base}images/icon128.png`} alt="" width="26" height="26" /><div><strong>SkillBridge</strong><small>AI Course Translator</small></div></div>
        <label class="extension-field"><span>{demoText.language}</span><select data-popup-language><option value="en">English</option><option value="ko" selected={locale === 'ko'}>Korean</option><option value="ja">Japanese</option><option value="es">Spanish</option></select></label>
        <label class="extension-toggle"><input type="checkbox" data-auto-translate checked /><span>{demoText.auto}</span></label>
        <label class="extension-toggle"><input type="checkbox" data-comment-translate /><span>{demoText.comments}</span></label>
        <button class="extension-sidebar-button" type="button" data-sidebar-toggle aria-expanded="false">{demoText.openSidebar}</button>
        <p class="extension-status" data-extension-status>{demoText.currentLesson}</p>
      </aside>
      <aside class="extension-sidebar" data-extension-sidebar hidden aria-label="SkillBridge Tutor">
        <div class="extension-sidebar-head"><strong>SkillBridge Tutor</strong><button type="button" data-tools-toggle aria-expanded="false" aria-label={demoText.learningTools}>...</button><button type="button" data-sidebar-close aria-label={demoText.closeSidebar}>x</button></div>
        <div class="extension-chat"><div class="extension-chat-message"><span>AI</span><p>{demoText.tutorGreeting}</p></div><div class="extension-example-questions"><button type="button">{demoText.askPassage}</button></div><div class="extension-chat-input"><textarea rows="1" placeholder={demoText.askPassage}></textarea><button type="button">{demoText.send}</button></div></div>
        <div class="extension-tools-menu" data-tools-menu hidden><button type="button">{demoText.recentLessons}</button><button type="button">{demoText.bookmarks}</button><button type="button">{demoText.notes}</button><button type="button">{demoText.reports}</button><button type="button">{demoText.flashcards}</button><button type="button">{demoText.exportPdf}</button></div>
      </aside>
    </div>
  </div>

    <div class="journey-notes shell"><article><span>01</span><div><h3>{ui.stepOpen}</h3><p>{ui.stepOpenBody}</p></div></article><article><span>02</span><div><h3>{ui.stepChoose}</h3><p>{ui.stepChooseBody}</p></div></article></div>
  </section>

  <section class="context-zone" id="context" aria-labelledby="context-title">
    <div class="context-copy shell"><p class="section-kicker">03 / {ui.contextEyebrow}</p><h2 id="context-title">{ui.contextTitle}</h2><p>{ui.contextBody}</p></div>
    <figure class="context-image shell"><img src={`${base}images/lesson-translated.png`} alt={ui.contextAlt} /><figcaption><img src={`${base}images/icon128.png`} alt="" width="30" height="30" /><div><strong>{ui.stepStay}</strong><p>{ui.contextNote}</p></div></figcaption></figure>
  </section>

  <section class="finish shell"><div class="finish-line"><span>04</span><i></i><small>{ui.flowTag}</small></div><div class="finish-copy"><h2>{ui.finalTitle}</h2><p>{ui.finalBody}</p></div><div class="finish-actions"><a class="install-button" href={storeUrl}>{ui.install}</a><a class="source-link" href="https://github.com/heznpc/skillbridge">{ui.source}</a></div></section>
</main>

<footer class="flow-footer shell"><a class="mark" href={localePath('en', base)}><img src={`${base}images/icon128.png`} alt="" width="28" height="28" /><span>SkillBridge</span></a><p>{ui.footer}</p><nav><a href={privacyUrl}>{ui.privacy}</a><a href="https://github.com/heznpc/skillbridge">{ui.sourceLabel}</a><a href="https://github.com/heznpc/skillbridge/blob/main/LICENSE">{ui.license}</a></nav></footer>

<script>
  const lessons = {
    intro: {
      number: '01',
      en: { title: 'Every lesson has a starting context.', body: 'SkillBridge begins on the course you already opened. Lesson navigation, learning progress, and the original page remain where you expect them.', term: 'course context', answer: 'The starting point is the existing course page. SkillBridge adds language support without creating a separate reading workspace.' },
      ko: { title: '모든 강의에는 이미 시작 맥락이 있습니다.', body: 'SkillBridge는 이미 열어 둔 강의에서 시작합니다. 강의 탐색과 학습 진도, 원래 페이지는 익숙한 위치에 그대로 남습니다.', term: 'course context', answer: '시작점은 이미 열어 둔 강의 페이지입니다. SkillBridge는 별도 읽기 공간을 만들지 않고 언어 지원만 더합니다.' },
      ja: { title: 'すべてのレッスンには既存の文脈があります。', body: 'SkillBridge はすでに開いているコース内で始まります。ナビゲーションと学習の進捗、元のページはそのまま残ります。', term: 'course context', answer: '開始点は既存のコースページです。別の読書スペースを作らず、言語サポートだけを追加します。' },
      es: { title: 'Cada lección ya tiene un contexto de inicio.', body: 'SkillBridge comienza dentro del curso que ya abriste. La navegación, el progreso y la página original permanecen en su lugar.', term: 'course context', answer: 'El punto de inicio es la página existente del curso. SkillBridge añade idioma sin crear otro espacio de lectura.' },
    },
    tools: {
      number: '02',
      en: { title: 'Tool use begins with a clear contract.', body: 'When a model receives a task, it needs both a capability and the rules for using it. This boundary is what makes tool calls reliable.', term: 'tool calls', answer: 'A clear contract says what a tool can do and which rules it must follow. That makes the result more predictable.' },
      ko: { title: '도구 사용은 명확한 계약에서 시작됩니다.', body: '모델이 작업을 받을 때는 기능뿐 아니라 그 기능을 사용하는 규칙도 함께 필요합니다. 이 경계가 도구 호출을 신뢰할 수 있게 만듭니다.', term: 'tool calls', answer: '명확한 계약은 도구가 할 수 있는 일과 따라야 할 규칙을 함께 정합니다. 그래서 결과를 더 예측할 수 있습니다.' },
      ja: { title: 'ツールの利用は明確な契約から始まります。', body: 'モデルがタスクを受け取るときは、機能だけでなくその使い方のルールも必要です。この境界がツール呼び出しの信頼性を支えます。', term: 'tool calls', answer: '明確な契約は、ツールができることと守るルールを決めます。そのため結果を予測しやすくなります。' },
      es: { title: 'El uso de herramientas empieza con un contrato claro.', body: 'Cuando un modelo recibe una tarea, necesita tanto una capacidad como las reglas para usarla. Ese límite hace que las llamadas a herramientas sean confiables.', term: 'tool calls', answer: 'Un contrato claro define lo que una herramienta puede hacer y las reglas que debe seguir. Así el resultado es más predecible.' },
    },
    guardrails: {
      number: '03',
      en: { title: 'Guardrails protect the learning boundary.', body: 'On assessment pages, SkillBridge skips answer choices and disables itself on recognized proctored routes. Language support should not change the rules of an evaluation.', term: 'assessment boundary', answer: 'The boundary is deliberate: lesson text can be translated, but answer choices and recognized proctored environments are left alone.' },
      ko: { title: '가드레일은 학습의 경계를 지킵니다.', body: '평가 페이지에서는 답안 선택지를 번역하지 않고, 감독형으로 인식한 경로에서는 확장 프로그램을 비활성화합니다. 언어 지원이 평가 규칙을 바꾸면 안 됩니다.', term: 'assessment boundary', answer: '이 경계는 의도적입니다. 강의 본문은 번역하되, 답안 선택지와 인식된 감독형 환경은 건드리지 않습니다.' },
      ja: { title: 'ガードレールは学習の境界を守ります。', body: '評価ページでは選択肢を翻訳せず、認識された監督ルートでは拡張機能を無効にします。言語サポートが評価のルールを変えるべきではありません。', term: 'assessment boundary', answer: 'これは意図した境界です。レッスン本文は翻訳できますが、選択肢と監督された環境には触れません。' },
      es: { title: 'Los límites protegen la evaluación.', body: 'En las páginas de evaluación, SkillBridge omite las opciones de respuesta y se desactiva en rutas supervisadas reconocidas. El idioma no debe cambiar las reglas de una evaluación.', term: 'assessment boundary', answer: 'El límite es intencional: el texto de la lección se puede traducir, pero las opciones y los entornos supervisados no se modifican.' },
    },
    practice: {
      number: '04',
      en: { title: 'Return to the idea when you are ready.', body: 'Save a flashcard, bookmark the lesson, and come back to the same point later. Study tools should extend the course instead of replacing it.', term: 'learning loop', answer: 'The learning loop is simple: read, save what matters, then return to the same lesson context when you are ready.' },
      ko: { title: '준비되었을 때 다시 같은 생각으로 돌아옵니다.', body: '플래시카드를 저장하고 강의를 북마크한 뒤, 나중에 같은 지점으로 돌아오세요. 학습 도구는 강의를 대체하는 대신 확장해야 합니다.', term: 'learning loop', answer: '학습 흐름은 단순합니다. 읽고, 중요한 내용을 저장한 뒤, 준비되었을 때 같은 강의 맥락으로 돌아옵니다.' },
      ja: { title: '準備ができたら、また同じ考えに戻れます。', body: 'フラッシュカードを保存し、レッスンをブックマークして、後で同じ場所に戻りましょう。学習ツールはコースを置き換えるのではなく拡張します。', term: 'learning loop', answer: '学習の流れはシンプルです。読み、大切な内容を保存し、準備ができたら同じレッスンの文脈に戻ります。' },
      es: { title: 'Vuelve a la idea cuando estés listo.', body: 'Guarda una tarjeta, marca la lección y vuelve al mismo punto más tarde. Las herramientas de estudio deben ampliar el curso, no reemplazarlo.', term: 'learning loop', answer: 'El ciclo es simple: lee, guarda lo importante y vuelve al mismo contexto cuando estés listo.' },
    },
  };

  const languageLabels = { en: 'English', ko: '한국어', ja: '日本語', es: 'Español' };
  document.querySelectorAll('[data-course-demo]').forEach((demo) => {
    const languageButtons = demo.querySelectorAll('[data-lang]');
    const stepButtons = demo.querySelectorAll('[data-step]');
    const languageLabel = demo.querySelector('[data-demo-language]');
    const title = demo.querySelector('[data-demo-title]');
    const body = demo.querySelector('[data-demo-body]');
    const term = demo.querySelector('[data-demo-term]');
    const status = demo.querySelector('[data-demo-status]');
    const progress = demo.querySelector('[data-demo-progress]');
    const tutorToggle = demo.querySelector('[data-tutor-toggle]');
    const tutorPanel = demo.querySelector('[data-tutor-panel]');
    const tutorClose = demo.querySelector('[data-tutor-close]');
    const tutorContext = demo.querySelector('[data-tutor-context]');
    const tutorPrompt = demo.querySelector('[data-tutor-prompt]');
    const tutorAnswer = demo.querySelector('[data-tutor-answer]');
    const tutorToggleLabel = demo.querySelector('[data-tutor-toggle-label]');
    const locale = demo.dataset.locale || 'en';
    let activeLanguage = demo.dataset.initialLanguage || 'en';
    let activeStep = 'tools';
    const isKorean = locale === 'ko';

    const closeTutor = () => {
      tutorPanel.hidden = true;
      tutorToggle.setAttribute('aria-expanded', 'false');
      tutorToggleLabel.textContent = isKorean ? 'Tutor 열기' : 'Open Tutor';
    };
    const setStep = (step) => {
      activeStep = step;
      const lesson = lessons[step][activeLanguage];
      languageLabel.textContent = languageLabels[activeLanguage];
      title.textContent = lesson.title;
      body.textContent = lesson.body;
      term.textContent = lesson.term;
      status.textContent = activeLanguage === 'en' ? (isKorean ? '원문 수업' : 'Original lesson') : (isKorean ? '이 수업에서 번역됨' : 'Translated in this lesson');
      progress.textContent = lessons[step].number + ' / 04';
      tutorContext.textContent = isKorean ? '현재 보이는 문단의 맥락을 바탕으로 질문해 보세요.' : 'Ask about the paragraph currently visible in this lesson.';
      tutorAnswer.textContent = lesson.answer;
      tutorAnswer.hidden = true;
      stepButtons.forEach((button) => {
        const isActive = button.dataset.step === step;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-current', isActive ? 'step' : 'false');
      });
      closeTutor();
    };
    languageButtons.forEach((button) => button.addEventListener('click', () => {
      activeLanguage = button.dataset.lang;
      languageButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      setStep(activeStep);
    }));
    stepButtons.forEach((button) => button.addEventListener('click', () => setStep(button.dataset.step)));
    tutorToggle.addEventListener('click', () => {
      const isOpen = tutorToggle.getAttribute('aria-expanded') === 'true';
      tutorPanel.hidden = isOpen;
      tutorToggle.setAttribute('aria-expanded', String(!isOpen));
      tutorToggleLabel.textContent = isOpen ? (isKorean ? 'Tutor 열기' : 'Open Tutor') : (isKorean ? 'Tutor 닫기' : 'Close Tutor');
    });
    tutorClose.addEventListener('click', closeTutor);
    tutorPrompt.addEventListener('click', () => { tutorAnswer.hidden = false; });
    setStep(activeStep);
  });
</script>
<script>
  document.querySelectorAll('[data-extension-demo]').forEach((demo) => {
    const sidebar = demo.querySelector('[data-extension-sidebar]');
    const sidebarToggle = demo.querySelector('[data-sidebar-toggle]');
    const sidebarClose = demo.querySelector('[data-sidebar-close]');
    const toolsToggle = demo.querySelector('[data-tools-toggle]');
    const toolsMenu = demo.querySelector('[data-tools-menu]');
    const language = demo.querySelector('[data-popup-language]');
    const autoTranslate = demo.querySelector('[data-auto-translate]');
    const status = demo.querySelector('[data-extension-status]');
    const rail = demo.closest('.journey-stage')?.querySelectorAll('[data-flow-step]') || [];
    const isKorean = demo.dataset.locale === 'ko';

    const setRail = (step) => {
      rail.forEach((button) => {
        const active = button.dataset.flowStep === step;
        button.classList.toggle('active', active);
        button.setAttribute('aria-current', active ? 'step' : 'false');
      });
    };

    const setSidebar = (open) => {
      if (!open && toolsMenu) {
        toolsMenu.hidden = true;
        toolsToggle?.setAttribute('aria-expanded', 'false');
      }
      sidebar.hidden = !open;
      sidebarToggle.setAttribute('aria-expanded', String(open));
      demo.dataset.mode = open ? 'sidebar' : 'popup';
      setRail(open ? 'sidebar' : 'popup');
    };

    sidebarToggle.addEventListener('click', () => setSidebar(sidebar.hidden));
    sidebarClose.addEventListener('click', () => setSidebar(false));
    toolsToggle?.addEventListener('click', () => {
      if (!toolsMenu) return;
      const open = toolsMenu.hidden;
      toolsMenu.hidden = !open;
      toolsToggle.setAttribute('aria-expanded', String(open));
    });

    language.addEventListener('change', () => {
      const label = language.options[language.selectedIndex].text;
      demo.dataset.mode = 'language';
      setRail('language');
      status.textContent = isKorean
        ? `${label}(으)로 설정했습니다. 현재 강의에 번역이 적용됩니다.`
        : `Language set to ${label}. Translation applies on the current lesson.`;
    });

    autoTranslate.addEventListener('change', () => {
      status.textContent = autoTranslate.checked
        ? (isKorean ? '현재 강의의 자동 번역을 켰습니다.' : 'Automatic translation is enabled for this lesson.')
        : (isKorean ? '현재 강의의 자동 번역을 일시 중지했습니다.' : 'Automatic translation is paused for this lesson.');
    });

    rail.forEach((button) => button.addEventListener('click', () => {
      const step = button.dataset.flowStep;
      if (step === 'sidebar') {
        setSidebar(true);
      } else {
        setSidebar(false);
        demo.dataset.mode = step;
        setRail(step);
        if (step === 'language') language.focus();
      }
    }));
  });
</script>
